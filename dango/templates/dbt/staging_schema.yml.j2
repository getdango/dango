# Auto-generated by Dango on {{ generated_at }}
# This file documents the staging models for {{ source_name | cmt }}
#
# WHAT ARE STAGING MODELS?
# Staging models clean and prepare raw data for analysis:
# - Rename columns to consistent naming conventions
# - Cast data types appropriately
# - Handle nulls and defaults
# - Apply deduplication logic
# - Add computed columns if needed
#
# EDITING THIS FILE:
# - Update descriptions as you learn about the data
# - Add tests (unique, not_null, accepted_values, etc.)
# - After a sync, Dango adds not_null checks inferred from a sample of your data, but only
#   to a file you have not edited since Dango last wrote it. Once you edit this file Dango
#   leaves it alone. To get Dango's checks again, delete the file and run `dango sync`.
# - Inferred not_null checks on ordinary columns only warn (severity: warn). Checks on
#   columns named id, uuid or key, and on columns the warehouse declares NOT NULL, fail the
#   run. Change the severity or delete a check if the sample was not representative.

version: 2

models:
{% for model in models %}
  - name: {{ model.name | ysc }}
    description: |
      {{ model.description | cmt }}
      Edit the SQL in `{{ model.name | cmt }}.sql` to customize transformations.

    columns:
{% for column in model.columns %}
      - name: {{ column.name | ysc }}
{% if column.name | nq %}
        quote: true
{% endif %}
{% if column.tests %}
        tests:
{% for test in column.tests %}
{% if test is string %}
          - {{ test }}
{% else %}
{% for test_name, test_body in test.items() %}
          - {{ test_name }}:
              config:
                severity: {{ test_body.config.severity }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
