services:
  # Metabase - BI Dashboards
  metabase:
    # Build custom Debian-based image for DuckDB compatibility (needs glibc/libstdc++)
    # Standard Metabase images use Alpine which lacks required libraries
    build:
      context: .
      dockerfile: Dockerfile.metabase
    ports:
      - "127.0.0.1:{{ metabase_port }}:3000"
    volumes:
      - metabase-data:/metabase-data
      # Note: :ro mount does NOT prevent DuckDB fcntl locks. Metabase stop/start
      # before sync (sync_trigger.py) is the actual write-lock prevention mechanism.
      # :ro is defense-in-depth only (prevents file writes, not lock acquisition).
      - ./data:/data:ro
      - ./metabase-plugins:/app/plugins
    environment:
      MB_DB_TYPE: h2
      MB_DB_FILE: /metabase-data/metabase.db
      MB_SITE_NAME: "{{ project_name }}"
      MB_ENABLE_PUBLIC_SHARING: false
      MB_ANON_TRACKING_ENABLED: false
      MB_PLUGINS_DIR: /app/plugins
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 300s
    restart: unless-stopped
    # Bounds this container's own stdout/stderr capture (JVM startup logs, health-check
    # noise) — never rotated before, so a long-lived project (especially an unattended
    # cloud deployment) could accumulate this indefinitely. Rotates like any standard
    # log setup (keep the last few segments up to a size cap each), not a wipe — same
    # keep-recent-history-but-bound-it principle as this project's own audit log
    # rotation (utils/log_rotation.py). Does not touch application-level audit logs at
    # all, only this container's own operational output.
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # dbt Docs - Documentation Server
  dbt-docs:
    image: nginx:alpine
    ports:
      - "127.0.0.1:{{ dbt_docs_port }}:80"
    volumes:
      - ./dbt/target:/usr/share/nginx/html:ro
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost/"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  metabase-data:
    driver: local
    labels:
      com.dango.project_name: "{{ project_name }}"
      com.dango.project_id: "{{ project_id }}"
